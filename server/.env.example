# 主控服务配置（复制为 .env 并按实际情况填写）
PORT=3004
HOST=127.0.0.1
DB_FILE=/var/www/monitor-v2/server/data/monitor.db

# 首次启动时初始化运维账号（逗号分隔），SEED_ADMIN_EMAIL 为管理员
SEED_OPERATORS=northland@xuanjian.top
SEED_ADMIN_EMAIL=northland@xuanjian.top

# 邮件通知（企业邮）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USER=northland@xuanjian.top
SMTP_PASS=
NOTIFY_EMAILS=northland@xuanjian.top

# 生产环境 Cookie 必须 Secure；本地 http 调试可设为 0
COOKIE_SECURE=1
